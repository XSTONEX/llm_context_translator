# 复制本文件为 .env 并填入真实值： cp .env.example .env

# ===== LLM（必填） =====
SILICONFLOW_API_KEY=your_api_key
LLM_API_BASE_URL=https://api.siliconflow.cn/v1

# ===== TTS（可选，DeerAPI 付费语音） =====
DEERAPI_KEY=
DEERAPI_BASE_URL=https://api.deerapi.com/v1

# ===== 访问鉴权（公网部署务必设置） =====
# 必须与扩展 config.js 中的 LCT_ACCESS_TOKEN 完全一致。留空 = 后端不鉴权（危险，任何人可消耗你的 API Key）。
# 生成： python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LCT_ACCESS_TOKEN=

# ===== 限流（可选） =====
LCT_RATE_LIMIT_REQUESTS=60
LCT_RATE_LIMIT_WINDOW_SECONDS=60

# ===== 生词本存储（可选） =====
# 生词本 SQLite 数据库路径，默认 service/data/favorites.db
# LCT_DB_PATH=/abs/path/to/favorites.db

# ===== 腾讯云 COS（收藏单词音频，可选） =====
# 桶权限建议「私有读写」；Secret 用子用户最小权限密钥，勿提交到 git。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=lct-audio-your-appid
COS_REGION=ap-guangzhou
# 对象 key 前缀，最终形如 tts/{user_id}/{lang}/{hash}.mp3
COS_PREFIX=tts

# ===== 其他（可选） =====
WORD_COUNT_THRESHOLD=3
